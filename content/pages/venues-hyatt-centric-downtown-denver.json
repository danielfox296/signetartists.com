     {
      "type": "DefRows",
      "props": {
       "id": "DefRows-h2",
       "cls": "def-list def-list--cards",
       "rows": [
        {
         "term": "Rooftop bar and patio",
         "art": "tree",
         "text": "The rooftop is an indoor-outdoor performance space with a bar, on the top floor. Huge folding glass doors open the indoor side to the patio, and the act can set up in a spot that covers both sides, wherever guests are standing. The hotel lists its Rooftop Terrace at about 1,260 sq ft, for up to 78 guests."
        },
        {
         "term": "Lobby",
         "art": "glass",
         "text": "The lobby is cozy, and it’s at street level."
        },
        {
         "term": "Colorado Ballroom",
         "art": "musicians",
         "text": "The Colorado Ballroom is on the top floor, with about 2,530 sq ft for up to 300 guests. It divides into three smaller spaces: Breckenridge (up to 120 guests), Aspen (up to 100) and Vail (up to 80)."
        },
        {
         "term": "Apple Blossom and the Hospitality Suite",
         "art": "plate",
         "text": "Apple Blossom, the hotel’s farm-to-table restaurant, offers the restaurant and its terrace (about 5,000 sq ft together) for weddings and gatherings. The hotel also has a Hospitality Suite with its own outdoor terrace."
        }
       ]
      }
     }
    ]
   }
