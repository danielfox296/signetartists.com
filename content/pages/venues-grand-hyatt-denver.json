        {
         "term": "Pinnacle Club",
         "art": "mountain",
         "text": "The Pinnacle Club is on the 38th floor, about 4,200 sq ft with views of the mountains and the city. It used to be the Petroleum Club, and the hotel uses it for weddings and receptions of up to about 350."
        },
        {
         "term": "Colorado Ballroom",
         "art": "musicians",
         "text": "The Colorado Ballroom is about 8,400 sq ft with 18-foot ceilings, for banquets of up to 640 and receptions of up to 1,000. It divides into two halves, with a foyer outside."
        },
        {
         "term": "Aspen Ballroom",
         "art": "glass",
         "text": "The Aspen Ballroom is about 5,900 sq ft, for banquets of up to 450 and receptions of up to 700."
        },
        {
         "term": "Maroon Peak",
         "art": "plate",
         "text": "Maroon Peak is about 960 sq ft, for dinners of up to 70."
        }
       ]
      }
