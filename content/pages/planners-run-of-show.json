     {
      "type": "Paragraph",
      "props": {
       "id": "Paragraph-12",
       "html": "Two of those rows are worth a second look. A clear <strong>7:00pm</strong> call to dinner is a great way to get 400 people from the bar to their seats, and the band can play them in. At the <strong>9:15pm</strong> changeover, the quartet can't move from its dinner setup to its dance setup silently, so the DJ plays through that gap.",
       "cls": "prose"
      }
     }
    ],
