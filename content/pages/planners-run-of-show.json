     {
      "type": "Paragraph",
      "props": {
       "id": "Paragraph-12",
       "html": "Two of those rows are worth a second look. The <strong>7:00pm</strong> call to dinner is the surest way to move four hundred people from a bar into a seated dinner, and the band plays them in. The <strong>9:15pm</strong> changeover matters because a quartet can't get from a dinner setup to a dance setup silently, so the DJ covers that gap.",
       "cls": "prose"
      }
     }
